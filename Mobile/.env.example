# EthioPrep Mobile App Environment Variables
# Copy this file to .env and fill in the actual values

# API Configuration
# IMPORTANT: Use a reachable URL from your device/emulator
# - For Android emulator: use http://10.0.2.2:5000/api (maps to host's localhost)
# - For iOS simulator: use http://localhost:5000/api
# - For physical device: use your computer's local IP address (e.g., http://192.168.1.100:5000/api)
# - For production: use your actual backend API URL
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Optional: App Configuration
EXPO_PUBLIC_APP_NAME=EthioPrep
EXPO_PUBLIC_APP_VERSION=1.0.0

# Optional: Analytics/Tracking (if implemented)
# EXPO_PUBLIC_ANALYTICS_ENABLED=true
# EXPO_PUBLIC_ANALYTICS_ID=your-analytics-id

# Note: This file is ignored by git for security reasons
# Never commit actual values to the repository
