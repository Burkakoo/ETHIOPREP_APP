NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ethioprep?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173
# CLIENT_ORIGINS=http://localhost:5173,https://your-production-domain.com
# Use CLIENT_ORIGINS for multiple allowed origins (comma-separated)
# If CLIENT_ORIGINS is not set, CLIENT_ORIGIN will be used
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Email (Gmail SMTP) — required for email verification and password reset
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" and paste it below
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
