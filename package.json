{
  "name": "ethioprep",
  "version": "0.1.0",
  "private": true,
  "description": "EthioPrep entrance exam preparation platform",
  "type": "module",
  "workspaces": [
    "Backend",
    "Web"
  ],
  "scripts": {
    "dev": "npm --workspace=Web run build && npm --workspace=Backend run start",
    "build": "npm --workspace=Web run build",
    "start": "npm --workspace=Backend run start",
    "web:dev": "npm --workspace=Web run dev",
    "web:build": "npm --workspace=Web run build",
    "mobile:start": "npm --prefix Mobile start",
    "check": "npm --workspace=Backend run check"
  },
  "dependencies": {
    "recharts": "^3.10.1"
  }
}
